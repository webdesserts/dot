default_shell "nu"
default_mode "locked"
on_force_close "detach"

theme "neapolitan-light"
simplified_ui true

// Match the Neapolitan light palette used by Pi and iTerm.
themes {
    neapolitan-light {
        text_unselected {
            base       "#352B35"
            background "#EDDFDD"
            emphasis_0 "#EF4780"
            emphasis_1 "#746770"
            emphasis_2 "#746770"
            emphasis_3 "#746770"
        }
        text_selected {
            base       "#EDDFDD"
            background "#4C414B"
            emphasis_0 "#EF4780"
            emphasis_1 "#E0D1CE"
            emphasis_2 "#E0D1CE"
            emphasis_3 "#E0D1CE"
        }
        ribbon_unselected {
            base       "#746770"
            background "#EDDFDD"
            emphasis_0 "#EF4780"
            emphasis_1 "#746770"
            emphasis_2 "#746770"
            emphasis_3 "#746770"
        }
        ribbon_selected {
            base       "#EDDFDD"
            background "#4C414B"
            emphasis_0 "#EF4780"
            emphasis_1 "#E0D1CE"
            emphasis_2 "#E0D1CE"
            emphasis_3 "#E0D1CE"
        }
        table_title {
            base       "#352B35"
            background "#EDDFDD"
            emphasis_0 "#EF4780"
            emphasis_1 "#746770"
            emphasis_2 "#746770"
            emphasis_3 "#746770"
        }
        table_cell_unselected {
            base       "#352B35"
            background "#EDDFDD"
            emphasis_0 "#EF4780"
            emphasis_1 "#746770"
            emphasis_2 "#746770"
            emphasis_3 "#746770"
        }
        table_cell_selected {
            base       "#EDDFDD"
            background "#4C414B"
            emphasis_0 "#EF4780"
            emphasis_1 "#E0D1CE"
            emphasis_2 "#E0D1CE"
            emphasis_3 "#E0D1CE"
        }
        list_unselected {
            base       "#746770"
            background "#EDDFDD"
            emphasis_0 "#EF4780"
            emphasis_1 "#746770"
            emphasis_2 "#746770"
            emphasis_3 "#746770"
        }
        list_selected {
            base       "#EDDFDD"
            background "#4C414B"
            emphasis_0 "#EF4780"
            emphasis_1 "#E0D1CE"
            emphasis_2 "#E0D1CE"
            emphasis_3 "#E0D1CE"
        }
        frame_selected {
            base       "#746770"
            background "#EDDFDD"
            emphasis_0 "#EF4780"
            emphasis_1 "#746770"
            emphasis_2 "#746770"
            emphasis_3 "#746770"
        }
        frame_highlight {
            base       "#EF4780"
            background "#EDDFDD"
            emphasis_0 "#EF4780"
            emphasis_1 "#EF4780"
            emphasis_2 "#EF4780"
            emphasis_3 "#EF4780"
        }
        exit_code_success {
            base       "#00A481"
            background "#EDDFDD"
            emphasis_0 "#00A481"
            emphasis_1 "#746770"
            emphasis_2 "#746770"
            emphasis_3 "#746770"
        }
        exit_code_error {
            base       "#DC3139"
            background "#EDDFDD"
            emphasis_0 "#DC3139"
            emphasis_1 "#746770"
            emphasis_2 "#746770"
            emphasis_3 "#746770"
        }
        multiplayer_user_colors {
            player_1 5
            player_2 4
            player_3 2
            player_4 3
            player_5 6
            player_6 1
            player_7 0
            player_8 8
            player_9 0
            player_10 0
        }
    }
}
