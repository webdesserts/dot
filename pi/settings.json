{
  "defaultProvider": "fireworks",
  "defaultModel": "accounts/fireworks/models/glm-5p3-flash",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:@luxusai/pi-hindsight",
    "npm:pi-subagents"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "skills": [
    "~/.config/agents/skills"
  ],
  "extensions": [
    "extensions/harness-context.ts",
    "extensions/notifications.ts"
  ],
  "lastChangelogVersion": "0.84.4",
  "theme": "neapolitan-light",
  "steeringMode": "all",
  "followUpMode": "all",
  "hideThinkingBlock": true,
  "enableInstallTelemetry": false,
  "editorPaddingX": 2,
  "outputPad": 1
}
